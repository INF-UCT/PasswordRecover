# Aplicación
APP_PORT=8080
APP_BASE_URL=https://chpass.inf.uct.cl
APP_TOKEN_TTL_MINUTES=10

# LDAP
LDAP_HOST=ldap.inf.uct.cl
LDAP_PORT=389
LDAP_USE_TLS=false
LDAP_BIND_DN=cn=admin,dc=inf,dc=uct,dc=cl
LDAP_BIND_PASSWORD=secret
LDAP_BASE_DN=dc=inf,dc=uct,dc=cl

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# SMTP
SMTP_HOST=smtp.inf.uct.cl
SMTP_PORT=587
SMTP_USER=noreply@inf.uct.cl
SMTP_PASSWORD=secret
SMTP_FROM=noreply@inf.uct.cl

# Ramtun
RAMTUN_HOST=https://api-ramtun.inf.uct.cl
RAMTUN_API_KEY=secret
